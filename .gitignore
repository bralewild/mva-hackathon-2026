# NUNCA versionar datos del paciente (obligacion del Data Use Agreement)
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.cram
*.fastq
*.fastq.gz
*.docx
data/
work/

# resultados espejados que contienen coordenadas del paciente
results/*.csv
results/*.tsv

# Las predicciones NO van al repo publico hasta despues del cierre (24 oct 2026).
# El CSV se sube directo al formulario del challenge, que es privado.
# El repo debe demostrar que el METODO funciona, no regalar el resultado.
submissions/*.csv

# Terminos HPO del paciente: el .docx es confidencial y no redistribuible
patient_hpo.tsv
*phenotype*.tsv

# Acceso directo local a los datos en WSL: es comodidad de esta maquina,
# no codigo del proyecto. Para quien clone el repo seria una ruta rota.
DATOS-EN-WSL.lnk

# Reportes HTML de QC: son estadisticas agregadas del genoma DEL PACIENTE
# (conteos por gen, por cromosoma, por tipo de variante). No aportan nada a la
# reproducibilidad — cualquiera que corra el pipeline los regenera — y ante un
# DUA estricto no vale la pena discutir si un agregado es reidentificable.
results/*.html
results/*.genes.txt
