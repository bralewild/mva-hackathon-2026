# Force LF everywhere: the scripts run inside WSL/Linux, and a file with CRLF
# fails with "bad interpreter: /usr/bin/env bash^M". Without this, the
# repository breaks the moment someone clones it on Linux.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.tsv  text eol=lf

